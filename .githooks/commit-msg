#!/bin/sh
# Refuses a commit whose subject isn't a Conventional Commit, by scripts/conventional.sh, the one
# rule the workflow's `commits` job checks too. `just setup` turns it on with
# `git config core.hooksPath .githooks`.
set -eu

# The subject is the first line that is neither blank nor a comment git strips.
subject=$(grep -v -e '^[[:space:]]*$' -e '^#' "$1" | head -n 1 || true)
exec "$(git rev-parse --show-toplevel)/scripts/conventional.sh" "$subject"
